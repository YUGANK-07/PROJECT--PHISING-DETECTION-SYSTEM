# ─────────────────────────────────────────────
#  Phishing Detector — Environment Variables
#  Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=development           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ── Database — PostgreSQL ────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=phishing_detector
POSTGRES_USER=phishing_user
POSTGRES_PASSWORD=change-me

# ── Database — MongoDB ───────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=phishing_html_cache

# ── Cache — Redis ────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_DNS=3600            # seconds
REDIS_TTL_WHOIS=86400         # seconds
REDIS_TTL_PREDICTION=300      # seconds

# ── PhishTank API ────────────────────────────
PHISHTANK_API_KEY=            # optional, leave blank for anon access
PHISHTANK_FEED_URL=http://data.phishtank.com/data/online-valid.json

# ── OpenPhish ────────────────────────────────
OPENPHISH_FEED_URL=https://openphish.com/feed.txt

# ── Tranco ───────────────────────────────────
TRANCO_LIST_URL=https://tranco-list.eu/top-1m.csv.zip

# ── Model ────────────────────────────────────
MODEL_ARTIFACT_DIR=models/artifacts
BERT_MODEL_NAME=distilbert-base-uncased
INFERENCE_DEVICE=cpu           # cpu | cuda

# ── Auth / Security ──────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
